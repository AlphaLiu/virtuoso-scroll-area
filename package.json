{
  "name": "virtuo-scroll-area",
  "version": "0.2.0",
  "description": "Zero-config, dependency-free scroll area for React: custom overlay scrollbar with hover reveal, scroll-to-top button, scroll context API, and optional react-virtuoso integrations.",
  "keywords": [
    "react",
    "scroll-area",
    "scrollbar",
    "overlay-scrollbar",
    "custom-scrollbar",
    "virtualized",
    "virtuoso",
    "react-virtuoso",
    "scroll-to-top",
    "ui"
  ],
  "license": "MIT",
  "author": "Alpha Liu <alpha.liu@me.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlphaLiu/virtuoso-scroll-area.git"
  },
  "homepage": "https://github.com/AlphaLiu/virtuoso-scroll-area#readme",
  "bugs": {
    "url": "https://github.com/AlphaLiu/virtuoso-scroll-area/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./virtuoso": {
      "types": "./dist/virtuoso.d.ts",
      "import": "./dist/virtuoso.js",
      "require": "./dist/virtuoso.cjs"
    },
    "./virtuoso-grid": {
      "types": "./dist/virtuoso-grid.d.ts",
      "import": "./dist/virtuoso-grid.js",
      "require": "./dist/virtuoso-grid.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "bun run typecheck && bun run test && bun run build && bun run verify:pack",
    "demo": "bun run build && cd examples/vite-demo && bun install && bun run dev",
    "demo:build": "bun run build && cd examples/vite-demo && bun install && bun run build",
    "demo:standalone": "bun run build && cd examples/vite-demo && bun install && cd ../.. && node scripts/build-standalone-demo.mjs",
    "verify:pack": "node scripts/verify-package.mjs",
    "changelog:section": "node scripts/changelog-section.mjs",
    "prepublishOnly": "bun run verify",
    "publish:dry": "npm publish --dry-run --registry=https://registry.npmjs.org/",
    "publish:npm": "npm publish --registry=https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-virtuoso": ">=4"
  },
  "peerDependenciesMeta": {
    "react-virtuoso": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react-virtuoso": "^4",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
